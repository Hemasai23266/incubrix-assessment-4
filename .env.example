# Every setting the service reads. Copy to .env and edit. No real keys needed for simulation.
APP_ENV=dev
API_TOKEN=change-me-admin-token
SIMULATION_MODE=true              # true = in-process mock platforms, never touches the internet
DATABASE_URL=postgresql+psycopg://incubrix:incubrix@db:5432/incubrix
REDIS_URL=redis://redis:6379/0
JOB_BACKEND=rq                    # rq (worker container) | inline (tests)
S3_ENDPOINT_URL=http://s3:8333        # SeaweedFS in compose; MinIO or AWS S3 also work
S3_PUBLIC_ENDPOINT_URL=http://localhost:8333
S3_ACCESS_KEY=local-access-key
S3_SECRET_KEY=local-secret-key
S3_BUCKET=incubrix-output
LOCAL_STORE_DIR=./evidence/local_store   # used when S3_ENDPOINT_URL is empty
CALLBACK_SIGNING_SECRET=change-me-callback-secret
# Callback URL safety (SSRF): HTTPS only, public addresses only. The two switches below are for LOCAL DEVELOPMENT ONLY and must stay false in any deployment.
CALLBACK_ALLOWED_PORTS=443,8443
CALLBACK_ALLOW_HTTP=false
CALLBACK_ALLOW_PRIVATE=false
CALLBACK_DNS_TIMEOUT=3                    # seconds allowed for the DNS lookup of a callback/fetch host
# URL input (POST /api/v1/files/from-url): the service downloads a file for you, with the same SSRF protections.
# http and https only, public addresses only, DNS pinned, every redirect re-validated, size and type limits.
MEDIA_FETCH_ALLOW_HTTP=true               # false = https only
MEDIA_FETCH_ALLOW_PRIVATE=false           # LOCAL DEVELOPMENT/TESTS ONLY: disables the address checks. Keep false in any deployment.
MEDIA_FETCH_ALLOWED_PORTS=80,443,8080,8443
MEDIA_FETCH_MAX_BYTES=10485760            # 10 MB hard limit
MEDIA_FETCH_ALLOWED_TYPES=image/png,image/jpeg,image/gif,image/webp,video/mp4,text/plain
MEDIA_FETCH_CONNECT_TIMEOUT=5             # seconds
MEDIA_FETCH_READ_TIMEOUT=10               # seconds per read
MEDIA_FETCH_TOTAL_TIMEOUT=20              # overall deadline in seconds
MEDIA_FETCH_MAX_REDIRECTS=3
# Outbound platform calls (live mode) and retry behaviour
HTTP_TIMEOUT_SECONDS=10                   # timeout for calls to a platform
MAX_INLINE_BACKOFF_SECONDS=3              # a 429 with a reset time up to this long is slept through once, longer ones are returned as retry_at
# Folder of secret files, one file per credentials_ref NAME (a read-only Docker volume in compose); empty = environment variables only
CREDENTIALS_DIR=
MOCK_PLATFORMS_URL=http://mocks:9100      # compose mock server (used when SIMULATION_MODE=false)
MAX_TEST_POST_LIFETIME_SECONDS=600        # test posts are deleted well inside 10 minutes
UNAVAILABLE_STOP_AFTER=5
RATE_LIMIT_PER_MINUTE=600                 # demo protection
PUBLIC_BASE_URL=http://localhost:8000
# Connector credentials are referenced by name from destination rows (credentials_ref), e.g.:
DISCOURSE_API_KEY=
LEMMY_PASSWORD=
DEVTO_API_KEY=
GHOST_ADMIN_KEY=
WEBHOOK_SECRET=

# Limits and timeouts
UPLOAD_MAX_BYTES=26214400
JOB_TIMEOUT_SECONDS=600
IDEMPOTENCY_CLAIM_TTL_SECONDS=60
IDEMPOTENCY_WAIT_SECONDS=5
